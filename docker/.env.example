# Configuration pour le projet MCP de tri automatique de documents

# ─────────────────────────────────────────────────────────────
# Modèle Ollama
# ─────────────────────────────────────────────────────────────
# Nom du modèle Ollama à utiliser pour l'analyse
# Options recommandées :
#   - deepseek-v3.1:671b-cloud (Cloud, performant mais nécessite connexion)
#   - llama3:latest (Local, recommandé pour débuter)
#   - mistral:latest (Local, alternative légère)
OLLAMA_MODEL_NAME=deepseek-v3.1:671b-cloud

# ─────────────────────────────────────────────────────────────
# Chemins
# ─────────────────────────────────────────────────────────────
# Chemin LOCAL vers le dossier des modèles Ollama
# Windows: C:\Users\VotreNom\.ollama
# Linux/Mac: ~/.ollama
OLLAMA_MODEL_PATH=${USERPROFILE}\.ollama

# Chemin LOCAL du dossier à trier
# Ce dossier sera monté dans /files dans le conteneur
FILES_TO_SORT=./files_to_sort

# ─────────────────────────────────────────────────────────────
# Ports
# ─────────────────────────────────────────────────────────────
# Port pour le serveur MCP
MCP_PORT=3000

# Port pour Ollama (si exécuté dans un conteneur séparé)
OLLAMA_PORT=11434

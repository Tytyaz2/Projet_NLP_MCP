# Configuration pour le projet MCP de tri automatique de documents

# ─────────────────────────────────────────────────────────────
# Gemini (Google AI) - GRATUIT
# ─────────────────────────────────────────────────────────────
# Clé API Gemini (gratuite sur https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modèle Gemini à utiliser
# Options : gemini-2.0-flash (rapide), gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash

# ─────────────────────────────────────────────────────────────
# Ollama (analyse de fichiers)
# ─────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434

# Modèle Ollama pour l'analyse de documents
# Options :
#   - gpt-oss:20b-cloud (Cloud, recommandé)
#   - llama3:latest (Local, alternative)
#   - mistral:latest (Local, alternative légère)
OLLAMA_MODEL_NAME=gpt-oss:20b-cloud


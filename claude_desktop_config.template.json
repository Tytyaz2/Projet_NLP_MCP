{
  "mcpServers": {
    "file-classifier": {
      "command": "docker",
      "args": [
        "run", "-i", "--rm",
        "-e", "OLLAMA_HOST=http://host.docker.internal:11434",
        "-e", "OLLAMA_MODEL_NAME=llama3:latest",
        "-v", "${USER_HOME}:/home/user",
        "docker-mcp"
      ]
    }
  }
}
